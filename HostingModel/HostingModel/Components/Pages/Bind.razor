@page "/bind"
@rendermode InteractiveServer
@*
    rendermode: por componente
    - None (sem interatividade): vazio
    - Server: InteractveServer
    - WebAssembly: InteractiveWebAssembly
    - Auto (Server -> WebAssembly): InteractiveAuto
*@
<h3>Bind</h3>

<div>
    @*
    Bind - One_Way (unidirecional): { get;* } - pega um dado
    *@
    <p>@Texto</p>
    
</div>

<div class="mt-3">
    @*
    Bind - Two-Way (Bidirecnional): { get;* set; } - pega um dado e também atribui
    *@
    <input @bind="Texto" class="form-control" />
</div>

<div class="mt-3">
    @*
    Bind - Two-Way (Bidirecnional): { get;* set; } - pega um dado e também atribui
    *@
    <input @bind="Texto" @bind:event="oninput" class="form-control" />
</div>

<div class="mt-3">
    <input @bind-value="Texto" @bind-value:event="oninput" class="form-control" />
</div>

<div class="mt-3">
    <input @bind-value="Texto" @bind-value:event="oninput" class="form-control" />
</div>

<div class="mt-3">
    <input @bind:get="Texto" @bind:set="(value) => {Texto = value!;}" @bind:event="oninput" class="form-control" />
</div>

@code {
    private string Texto { get; set; } = "Eu sou um texto!";
}

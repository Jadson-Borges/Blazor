@page "/event"
@rendermode InteractiveServer
<h3>Event</h3>

<div class="mt-3">
    <button class="btn btn-secondary" onclick="javascript:alert('Clicou no botão javascript')">Clique-me (JS)</button>
    <button class="btn btn-primary" @onclick="ClickButtonOne">Clique-me (Blazor)</button>
    <br />
    @TextoOne
    
</div>


<div class="mt-3">
    <button class="btn btn-success" @onclick="@((e) => { TextoTwo = $"Posição do click: x={e.ScreenX} y{e.ScreenY}";})">Clique-me (Blazor-Inline)</button>
    <br />
    @TextoTwo
</div>


@code {
    private string TextoOne { get; set; } = string.Empty;
    private string TextoTwo { get; set; } = string.Empty;
    public void ClickButtonOne(MouseEventArgs e)
    {
        TextoOne = $"Posição do click: x={e.ScreenX} y{e.ScreenY}";
    }

    
}
